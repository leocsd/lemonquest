{
  "name": "lemonquest",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w @lemonquest/server\" \"npm:dev -w @lemonquest/client\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build -w @lemonquest/client",
    "build:server": "node tools/build-server.mjs",
    "start": "npm run build && npm run start -w @lemonquest/server",
    "start:fast": "npm run start -w @lemonquest/server",
    "start:bundle": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning node packages/server/dist/server.mjs",
    "smoke": "node tools/smoke.mjs",
    "newbie": "node tools/newbie.mjs",
    "wiki": "tsx tools/wiki/generate.mts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "admin": "npm run admin -w @lemonquest/server --"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
