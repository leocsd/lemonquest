assets/wiki/

# Logs
*.log
logs/

# Dados do container Docker (banco e backups)
docker-data/
docker-data-dev/

# Playwright (E2E)
playwright-report/
test-results/
tools/mapgen/_v/

# Previews do mapa: regenerados pelo tools/mapgen (preview.png tem ~8 MB e já custou 42 MB de histórico)
assets/maps/preview*.png
assets/maps/review/

# Segredos locais (ex.: LEMONQUEST_CLICKUP_TOKEN para o docker compose): nunca versionar
.env
.env.*
!.env.example

# App de desktop (Tauri): compilação do Rust e arquivos gerados pela CLI
packages/desktop/src-tauri/target/
packages/desktop/src-tauri/gen/
# Ícones de Android/iOS que `tauri icon` gera junto com os de desktop: o app não os usa
packages/desktop/src-tauri/icons/android/
packages/desktop/src-tauri/icons/ios/
