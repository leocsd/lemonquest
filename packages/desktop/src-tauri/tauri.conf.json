{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Lemon Quest",
  "version": "../package.json",
  "identifier": "com.lemonquest.desktop",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNjJCQ0I1QzhGRTIwQzUKUldURklQN0l0YnhpcXY2Qk9seTNPcEUxdXc1M2QrbzdRMlNJQU5jT0U0cmsyY2p6dHpYVVlLU2gK",
      "endpoints": ["https://github.com/leocsd/lemonquest/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
